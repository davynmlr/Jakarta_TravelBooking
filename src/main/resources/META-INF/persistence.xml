<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="travelPU">
        <jta-data-source>java:/labsDS</jta-data-source>
        <class>ch.hevs.travel.entity.Passenger</class>
        <class>ch.hevs.travel.entity.Flight</class>
        <class>ch.hevs.travel.entity.EconomyFlight</class>
        <class>ch.hevs.travel.entity.BusinessFlight</class>
        <class>ch.hevs.travel.entity.Destination</class>
        <properties>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.jpa.compliance.query" value="false"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>

</persistence>